# 課題1〜4完了後、HAProxyノード上で /etc/haproxy/haproxy.cfg が
# 概ね以下のような内容になっていることを確認する際の参考例です。
# (ホスト名・IPアドレスは環境の実際の値に置き換えてください)

global
    log /dev/log local0
    maxconn 2000

defaults
    log     global
    mode    http
    timeout connect 5000ms
    timeout client  50000ms
    timeout server  50000ms

frontend http_front
    bind *:80
    default_backend http_back

backend http_back
    balance roundrobin
    server web1 192.0.2.11:8080 check
    server web2 192.0.2.12:8080 check
    server web3 192.0.2.13:8080 check

listen stats
    bind *:8404
    stats enable
    stats uri /
    stats auth admin:ChangeMe123!
